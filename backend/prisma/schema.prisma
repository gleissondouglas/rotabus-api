generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enum de papéis do usuário — o PostgreSQL rejeita qualquer valor fora desta lista.
enum Role {
  USER
  ADMIN
}

// Enum de estados da sessão de conversa — garante integridade da FSM no banco.
enum SessionState {
  IDLE
  WAITING_DESTINATION
  WAITING_DESTINATION_SELECTION
  WAITING_CONFIRMATION
  WAITING_TIME_SELECTION
  JOURNEY_DISPLAYED
  ERROR
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String               @db.VarChar(100)
  email               String               @unique @db.VarChar(254)
  passwordHash        String
  pushToken           String?              @db.VarChar(200)
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  passwordResetTokens PasswordResetToken[]
  apiUsages           ApiUsage[]
  conversationSessions ConversationSession[]
  favorites           UserFavorite[]
  searchHistory       SearchHistory[]
}

model ConversationSession {
  id           String        @id @default(uuid())
  sessionId    String        @unique
  userId       Int?
  currentState SessionState  @default(IDLE)
  context      Json
  expiresAt    DateTime
  endedAt      DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, sessionId])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  tokenHash String    @unique
  userId    Int
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RouteCache {
  id               Int      @id @default(autoincrement())
  cacheKey         String   @unique @db.VarChar(512)
  googleResponse   Json
  timePreference   Json?
  createdAt        DateTime @default(now())
  expiresAt        DateTime

  @@index([cacheKey])
}

model ApiUsage {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ipAddress String   @db.VarChar(45)
  endpoint  String   @db.VarChar(100)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

model UserFavorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  name      String   @db.VarChar(200)
  address   String   @db.VarChar(500)
  lat       Float
  lng       Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SearchHistory {
  id          Int      @id @default(autoincrement())
  userId      Int
  query       String   @db.VarChar(500)
  address     String?  @db.VarChar(500)
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
